{
  "name": "testpilot5250",
  "version": "0.1.0",
  "private": true,
  "description": "Automated end-to-end testing for IBM i 5250 green-screen applications (RPGLE/CLLE/DDS)",
  "workspaces": [
    "packages/tn5250",
    "packages/core",
    "packages/simulator",
    "packages/server"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "npm run web:build && node --no-warnings packages/server/src/index.js",
    "server": "node --no-warnings packages/server/src/index.js",
    "demo": "node --no-warnings scripts/demo.js",
    "simulator": "node packages/simulator/src/cli.js",
    "web:install": "npm --prefix web install",
    "web:build": "npm --prefix web run build",
    "web:dev": "npm --prefix web run dev",
    "test": "node --no-warnings --test packages/tn5250/test/*.test.js packages/core/test/*.test.js",
    "test:e2e": "node --no-warnings packages/core/src/cli.js run samples/tests --env samples/env.simulator.json --report out/reports"
  }
}

{
  "name": "DEV400 (real IBM i)",
  "host": "dev400.example.com",
  "port": 992,
  "tls": true,
  "user": "${TP_USER}",
  "password": "${TP_PASSWORD}",
  "devicePrefix": "TP",
  "coverageAdapter": "codecov",
  "codecov": {
    "transport": "sftp",
    "sshHost": "dev400.example.com",
    "sshUser": "${TP_USER}",
    "sshPassword": "${TP_PASSWORD}",
    "sourceDir": "./src"
  },
  "variables": { "LIB": "ORDLIB" }
}
